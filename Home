<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Revistas PPGAD</title>
<style>
:root{--bg:#fbf9f3;--card:#fff;--ink:#1c2a24;--mut:#55625b;--line:#e3dfd2;--g:#0b5b45;--chip:#f3f0e4}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#161a17;--card:#1f2521;--ink:#eef0ea;--mut:#a5afa8;--line:#333b36;--g:#4fb08f;--chip:#2a312d}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,.brand{font-family:Georgia,"Times New Roman",serif;font-weight:400}
header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 24px;padding:14px 34px;border-bottom:1px solid var(--line)}
.brand{font-size:26px}.brand small{font:13px system-ui,sans-serif;color:var(--mut);margin-left:6px}
nav{display:flex;gap:4px}
nav a{padding:6px 12px;border-radius:6px;color:var(--mut);text-decoration:none}
nav a.on{background:var(--chip);color:var(--ink)}
main{max-width:1180px;padding:0 34px 48px}
h1{font-size:clamp(30px,5vw,48px);line-height:1.2;margin:40px 0 20px;max-width:760px}
.lead{color:var(--mut);max-width:780px;font-size:16px}
.layout{display:grid;grid-template-columns:280px 1fr;gap:24px;margin-top:32px;align-items:start}
@media(max-width:800px){.layout{grid-template-columns:1fr}header,main{padding-left:16px;padding-right:16px}}
aside{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
label{display:block;font-size:12px;letter-spacing:.04em;color:var(--mut);margin:14px 0 6px;text-transform:uppercase}
aside label:first-child{margin-top:0}
input[type=text],select{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);font:inherit}
input[type=range]{width:100%;accent-color:var(--g)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button,.btn{font:inherit;font-weight:500;padding:9px 14px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);cursor:pointer;text-decoration:none;display:inline-block}
button:hover,.btn:hover{border-color:var(--g)}
:focus-visible{outline:2px solid var(--g);outline-offset:2px}
aside button{width:100%;margin-top:18px;padding:12px}
.bar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px;color:var(--mut)}
.bar div{display:flex;gap:10px}.bar select{width:auto}
.card{position:relative;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin-bottom:16px}
.card h2{font-size:21px;margin:0 0 2px;padding-right:100px}
.meta{font-size:12.5px;color:var(--mut)}
.card p{margin:8px 0 12px}
.cmp{position:absolute;top:16px;right:18px;font-size:13px;color:var(--mut);display:flex;gap:6px;align-items:center}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.chips span{background:var(--chip);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:13px}
.act{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.act small{color:var(--mut)}
.empty{padding:40px 0;color:var(--mut)}
#comparar{display:none}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line)}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
.scroll{overflow-x:auto}
</style>
</head>
<body>
<header>
  <div class="brand">Revistas PPGAD <small>consulta para submissões</small></div>
  <nav>
    <a href="#" id="nav-rev" class="on">Revistas</a>
    <a href="#comparar" id="nav-cmp">Comparar</a>
    <a href="#">Sugerir revista</a>
    <a href="#">Guia de uso</a>
    <a href="#">Sobre</a>
  </nav>
</header>

<main>
  <h1>Onde submeter o seu artigo, com os indicadores na mesma tela</h1>
  <p class="lead">Catálogo de revistas alinhadas às áreas do PPGAD, com percentil do índice H acima da mediana da categoria, quartil SJR, Qualis, custo de publicação e tempo até a publicação. Base atualizada em <span id="base-data"></span>.</p>

  <div class="layout" id="revistas">
    <aside aria-label="Filtros">
      <label for="q">Busca por palavra-chave</label>
      <input type="text" id="q" placeholder="título, escopo, editora, ISSN">
      <label for="area">Área</label>
      <select id="area"><option value="">Todas as áreas</option></select>
      <label for="perc">Percentil mínimo do índice H: <span id="perc-v">50</span></label>
      <input type="range" id="perc" min="0" max="100" value="50">
      <div class="two">
        <div><label for="sjr">Quartil SJR</label><select id="sjr"><option value="">Todos</option><option>Q1</option><option>Q2</option><option>Q3</option><option>Q4</option></select></div>
        <div><label for="qualis">Qualis</label><select id="qualis"><option value="">Todos</option></select></div>
      </div>
      <label for="acesso">Modelo de acesso</label>
      <select id="acesso"><option value="">Todos</option></select>
      <label for="taxa">Taxa de publicação até <span id="taxa-v"></span></label>
      <input type="range" id="taxa" min="0" step="100">
      <label for="dias">Tempo até publicação até <span id="dias-v"></span></label>
      <input type="range" id="dias" min="0" step="1">
      <button type="button" id="limpar">Limpar filtros</button>
    </aside>

    <section aria-live="polite">
      <div class="bar">
        <span id="count"></span>
        <div>
          <select id="ord" aria-label="Ordenar">
            <option value="h">Ordenar: maior percentil H</option>
            <option value="nome">Ordenar: nome (A–Z)</option>
            <option value="taxa">Ordenar: menor taxa</option>
            <option value="dias">Ordenar: menor prazo</option>
          </select>
          <button type="button" id="csv">Exportar CSV</button>
        </div>
      </div>
      <div id="lista"></div>
    </section>
  </div>

  <section id="comparar">
    <h2 style="font-size:28px;margin:32px 0 12px">Comparar revistas</h2>
    <div class="scroll" id="cmp-tabela"></div>
  </section>
</main>

<script>
// ====== DADOS: edite/adicione revistas aqui ======
// url_ficha e url_instrucoes: coloque o link real de cada revista.
const BASE_ATUALIZADA = "20/09/2026";
const REVISTAS = [
  {id:1, titulo:"Journal of Business Research", editora:"Elsevier", issn:"0148-2963", area:"Administração",
   escopo:"Pesquisa empírica e teórica em administração, marketing, estratégia e comportamento organizacional.",
   qualis:"A1", sjr:"Q1", h:264, percentil:99, acesso:"Híbrido", taxa:21400, dias:105, url_ficha:"", url_instrucoes:"", atualizado:"20/09/2026"},
  {id:2, titulo:"Journal of Cleaner Production", editora:"Elsevier", issn:"0959-6526", area:"Administração",
   escopo:"Produção sustentável, gestão ambiental e economia circular nas organizações.",
   qualis:"A1", sjr:"Q1", h:309, percentil:99, acesso:"Híbrido", taxa:19600, dias:112, url_ficha:"", url_instrucoes:"", atualizado:"20/09/2026"},
  {id:3, titulo:"PLOS ONE", editora:"PLOS", issn:"1932-6203", area:"Sistemas de Informação e Ciência de Dados",
   escopo:"Multidisciplinar, aceita estudos quantitativos em gestão e dados.",
   qualis:"A3", sjr:"Q1", h:435, percentil:99, acesso:"Acesso aberto", taxa:12300, dias:164, url_ficha:"", url_instrucoes:"", atualizado:"20/09/2026"}
];
// =================================================

const $ = id => document.getElementById(id);
const brl = n => "R$ " + n.toLocaleString("pt-BR");
const uniq = k => [...new Set(REVISTAS.map(r => r[k]))].sort();
const maxTaxa = Math.max(...REVISTAS.map(r => r.taxa)), maxDias = Math.max(...REVISTAS.map(r => r.dias));
const sel = new Set();

$("base-data").textContent = BASE_ATUALIZADA;
[["area","area"],["qualis","qualis"],["acesso","acesso"]].forEach(([el,k]) => uniq(k).forEach(v => $(el).add(new Option(v, v))));
$("taxa").max = maxTaxa; $("taxa").value = maxTaxa;
$("dias").max = maxDias; $("dias").value = maxDias;

function filtradas(){
  const q = $("q").value.trim().toLowerCase();
  const r = REVISTAS.filter(x =>
    (!q || [x.titulo,x.escopo,x.editora,x.issn].join(" ").toLowerCase().includes(q)) &&
    (!$("area").value || x.area === $("area").value) &&
    x.percentil >= +$("perc").value &&
    (!$("sjr").value || x.sjr === $("sjr").value) &&
    (!$("qualis").value || x.qualis === $("qualis").value) &&
    (!$("acesso").value || x.acesso === $("acesso").value) &&
    x.taxa <= +$("taxa").value && x.dias <= +$("dias").value);
  const o = $("ord").value;
  return r.sort((a,b) => o==="nome" ? a.titulo.localeCompare(b.titulo) : o==="taxa" ? a.taxa-b.taxa : o==="dias" ? a.dias-b.dias : b.percentil-a.percentil || b.h-a.h);
}

const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const link = (u,t) => u ? `<a class="btn" href="${esc(u)}" target="_blank" rel="noopener">${t}</a>` : `<span class="btn" aria-disabled="true" style="opacity:.55;cursor:default">${t}</span>`;

function render(){
  $("perc-v").textContent = $("perc").value;
  $("taxa-v").textContent = +$("taxa").value >= maxTaxa ? "qualquer valor" : brl(+$("taxa").value);
  $("dias-v").textContent = +$("dias").value >= maxDias ? "qualquer prazo" : $("dias").value + " dias";
  const r = filtradas();
  $("count").textContent = r.length + (r.length === 1 ? " revista encontrada" : " revistas encontradas");
  $("lista").innerHTML = r.length ? r.map(x => `
    <article class="card">
      <label class="cmp"><input type="checkbox" data-id="${x.id}" ${sel.has(x.id)?"checked":""}> comparar</label>
      <h2>${esc(x.titulo)}</h2>
      <div class="meta">${esc(x.editora)} · ISSN ${esc(x.issn)} · ${esc(x.area)}</div>
      <p>${esc(x.escopo)}</p>
      <div class="chips"><span>Qualis ${esc(x.qualis)}</span><span>${esc(x.sjr)}</span><span>h ${x.h}</span><span>percentil ${x.percentil}</span><span>${esc(x.acesso)}</span><span>${brl(x.taxa)}</span><span>~${x.dias} dias até publicar</span></div>
      <div class="act">${link(x.url_ficha,"Ver ficha")}${link(x.url_instrucoes,"Instruções aos autores")}<small>atualizado em ${esc(x.atualizado)}</small></div>
    </article>`).join("") : `<p class="empty">Nenhuma revista com esses filtros. Reduza o percentil mínimo ou clique em "Limpar filtros".</p>`;
  renderCmp();
}

function renderCmp(){
  const r = REVISTAS.filter(x => sel.has(x.id));
  $("cmp-tabela").innerHTML = r.length ? `<table><tr><th></th>${r.map(x=>`<th>${esc(x.titulo)}</th>`).join("")}</tr>` +
    [["Editora","editora"],["ISSN","issn"],["Área","area"],["Qualis","qualis"],["Quartil SJR","sjr"],["Índice H","h"],["Percentil H","percentil"],["Acesso","acesso"]]
      .map(([l,k]) => `<tr><th>${l}</th>${r.map(x=>`<td>${esc(x[k])}</td>`).join("")}</tr>`).join("") +
    `<tr><th>Taxa</th>${r.map(x=>`<td>${brl(x.taxa)}</td>`).join("")}</tr><tr><th>Tempo até publicar</th>${r.map(x=>`<td>~${x.dias} dias</td>`).join("")}</tr></table>`
    : `<p class="empty">Marque "comparar" nos cartões da lista para ver as revistas lado a lado.</p>`;
}

function aba(cmp){
  $("revistas").style.display = cmp ? "none" : "";
  $("comparar").style.display = cmp ? "block" : "none";
  $("nav-rev").classList.toggle("on", !cmp); $("nav-cmp").classList.toggle("on", cmp);
}
$("nav-rev").onclick = e => { e.preventDefault(); aba(false); };
$("nav-cmp").onclick = e => { e.preventDefault(); aba(true); };

$("lista").addEventListener("change", e => { const id = +e.target.dataset.id; if(!id) return; e.target.checked ? sel.add(id) : sel.delete(id); renderCmp(); });
["q","area","perc","sjr","qualis","acesso","taxa","dias","ord"].forEach(id => $(id).addEventListener("input", render));
$("limpar").onclick = () => {
  ["q","area","sjr","qualis","acesso"].forEach(id => $(id).value = "");
  $("perc").value = 50; $("taxa").value = maxTaxa; $("dias").value = maxDias; render();
};
$("csv").onclick = () => {
  const cols = ["titulo","editora","issn","area","qualis","sjr","h","percentil","acesso","taxa","dias","atualizado"];
  const linhas = [cols.join(";")].concat(filtradas().map(r => cols.map(c => '"' + String(r[c]).replace(/"/g,'""') + '"').join(";")));
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob(["\ufeff" + linhas.join("\n")], {type:"text/csv;charset=utf-8"}));
  a.download = "revistas-ppgad.csv"; a.click(); URL.revokeObjectURL(a.href);
};
render();
</script>
</body>
</html>
